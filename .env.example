APP_NAME=RedPits
HOST=0.0.0.0
PORT=8000

# RedPits uses its own local AI engine. Do not put Gemini, Replicate, or HF inference credentials here.
PROVIDER=self-hosted
AI_ENGINE_URL=http://127.0.0.1:8100
AI_ENGINE_TOKEN=change-this-to-a-long-random-secret
AI_REQUEST_TIMEOUT=3600

STORAGE_DIR=./storage
DB_PATH=./storage/redpits.db
MAX_MOVIE_SCENES=20
MAX_PROMPT_LENGTH=100000
MOVIE_MAX_DURATION=60
AI_MAX_VIDEO_SECONDS=6
AI_DEFAULT_FPS=24
SESSION_COOKIE_SECURE=true
