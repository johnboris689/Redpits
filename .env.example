APP_NAME=RedPits
HOST=0.0.0.0
PORT=8000

# 100% free provider path: Render hosts RedPits; Hugging Face ZeroGPU Spaces do inference.
PROVIDER=huggingface

# Public Spaces work without a token. A free HF token can improve authenticated access/rate limits.
HF_TOKEN=
HF_VIDEO_SPACE=techfreakworm/LTX2.3-Studio
HF_IMAGE_SPACE=mrfakename/Z-Image-Turbo

# Free/ZeroGPU-friendly defaults.
HF_MAX_VIDEO_SECONDS=6
HF_FPS=24
HF_WIDTH=576
HF_HEIGHT=1024
HF_STEPS=8
HF_SEED=42
HF_VIDEO_PRESET=fast

STORAGE_DIR=./storage
DB_PATH=./storage/redpits.db
MAX_MOVIE_SCENES=20
MAX_PROMPT_LENGTH=100000
MOVIE_MAX_DURATION=60
